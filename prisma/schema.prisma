// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum League {
  NBA
  NFL
  MLB
  SOCCER
  NHL
}

enum UserRole {
  USER
  ADMIN
}

enum SystemTaskType {
  GENERATE_ARTICLES
  PUBLISH_SOCIAL_POST
  STORY_GENERATOR
}

enum SystemTaskRole {
  AI
  USER
}

enum SystemTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  articles      Article[] // 👈 back-relation, so Prisma knows the other side

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Article {
  id          String  @id @default(cuid())
  slug        String  @unique
  league      League
  title       String
  excerpt     String
  originalUrl String? @unique

  // 👉 ADD THIS: The actual AI-generated article body. 
  // @db.Text allows for long-form content beyond the standard varchar limit.
  content String @db.Text

  createdAt   DateTime @default(now())
  readMinutes Int
  image       String
  featured    Boolean  @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([league])
  @@index([slug])
  @@index([authorId])
}

model SocialPost {
  id        String   @id @default(cuid())
  handle    String
  caption   String
  image     String
  likes     Int // Store as a real number (e.g., 24100) so you can sort by most popular
  createdAt DateTime @default(now())
}

model SystemTask {
  id        String           @id @default(uuid())
  status    SystemTaskStatus
  type      SystemTaskType
  lockKey   String?
  initiator SystemTaskRole
  metadata  Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
}
model DailySpotlight {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  league          String

  gameId          String
  bdlGameId       String?
  homeTeam        String
  awayTeam        String

  // selection
  selectionMode   String   @default("auto")   // 'auto' | 'manual'
  selectionScore  Float?                       // computed score, for debugging/tuning
  selectionReason Json?                        // { spread: 2.5, primetime: true, standingsGap: 3 } — breakdown for future admin UI
  selectedBy      String?      
  gameStartTime   DateTime               // null for auto, userId once admin exists

  requestBudget   Int      @default(10)
  requestsUsed    Int      @default(0)

  stories         SportStory[]

  createdAt       DateTime @default(now())

  @@unique([date, league])
}

model SportStory {
  id            String   @id @default(cuid())

  spotlightId   String
  spotlight     DailySpotlight @relation(fields: [spotlightId], references: [id])

  league        String
  phase         String              // 'pregame' | 'live' | 'postgame'
  audience      String              // 'stats' | 'betting'
  tone          String              // 'editorial' | 'humor'

  baseNarrative String?  @db.Text
  sources       Json?
  article       String?  @db.Text

  taskId        String?
  status        String   @default("pending")
  errorMessage  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publishedAt   DateTime?
  scheduledFor  DateTime

  @@index([spotlightId, phase])
  @@index([status])
}